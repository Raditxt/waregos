# Env web. Salin ke apps/web/.env.local kalau perlu mengubah default.
# File asli TIDAK PERNAH masuk repo.

# Base URL REST API, diakhiri /api. Dibaca hanya di src/lib/config.ts.
# Nilai ini DITANAM saat build (static export): ganti nilainya = build ulang.
# Kosong: http://localhost:3001/api (API dev lokal).
# Produksi (setelah cutover): https://api.waregos.com/api, diisi di pengaturan build Cloudflare Pages.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
