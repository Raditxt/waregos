# Env API untuk pengembangan lokal. Salin ke apps/api/.env lalu isi.
# File asli TIDAK PERNAH masuk repo. Produksi (VPS) diisi lewat deploy/.env.example.

# --- Wajib -------------------------------------------------------------------
# Koneksi Postgres. Dev: Postgres lokal saja (localhost:5432).
# Nilainya biasanya sama dengan DATABASE_URL di packages/database/.env.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/waregos?schema=public"

# Rahasia penanda tangan token login. Produksi: minimal 32 karakter, kalau kurang API menolak start.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="minimum-32-character-random-string-here"

# Origin web yang boleh memanggil API, dipisah koma. Kalau kosong, SEMUA request dari
# browser ditolak (di dev API tetap start, tapi web tidak bisa login).
# Produksi wajib diisi; kalau kosong, API menolak start.
CORS_ORIGINS="http://localhost:3000"

# --- Opsional ----------------------------------------------------------------
# Port dan alamat bind. Default 3001 dan 0.0.0.0.
# (Kalau API_PORT kosong, API membaca PORT, sisa dari hosting Railway.)
API_PORT=3001
API_HOST="0.0.0.0"

# `production` menyalakan pemeriksaan wajib di atas (CORS_ORIGINS, panjang JWT_SECRET,
# TRUST_PROXY_CIDRS) dan mode log produksi.
NODE_ENV="development"

# CIDR proxy tepercaya untuk X-Forwarded-For, dipisah koma (ADR 0008).
# Dev tanpa proxy: biarkan kosong (IP klien = alamat koneksi).
# Produksi wajib diisi (subnet internal Docker); kalau kosong, API menolak start.
TRUST_PROXY_CIDRS=""
