DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/tokoqu_db?schema=public"
JWT_SECRET="minimum-32-character-random-string-here"
API_PORT=3001
API_HOST="0.0.0.0"
NODE_ENV="development"
# CIDR proxy tepercaya untuk X-Forwarded-For, dipisah koma (ADR 0008).
# Dev tanpa proxy: biarkan kosong. Produksi wajib diisi (subnet internal Docker);
# kalau kosong, API menolak start.
TRUST_PROXY_CIDRS=""
