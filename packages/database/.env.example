# Env untuk Prisma CLI (migrate, generate, studio) dan seed. Salin ke packages/database/.env.
# File ini terpisah dari apps/api/.env karena Prisma CLI membaca .env dari folder paket ini.
# File asli TIDAK PERNAH masuk repo.
#
# HANYA localhost. Sebelum `db:deploy`, `db:migrate` atau `db:seed`, baca baris
# "Datasource" yang dicetak Prisma; kalau bukan localhost:5432, hentikan.

# Koneksi yang dipakai Prisma Client dan seed. Biasanya sama dengan apps/api/.env.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/waregos?schema=public"

# Koneksi langsung (tanpa pooler) untuk migrasi. Di Postgres lokal isinya sama dengan DATABASE_URL.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/waregos?schema=public"

# --- Seed --------------------------------------------------------------------
# Hanya dibaca kalau NODE_ENV=production (mis. gladi bersih Docker). Password minimal 12 karakter.
# Di dev, seed membuat akun contoh sendiri: admin / admin123 (Admin) dan ibu / kasir123 (Kasir).
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=ganti-dengan-kalimat-sandi
