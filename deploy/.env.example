# Salin ke /srv/waregos/.env (di VPS) atau deploy/.env.local (laptop), lalu isi.
# File asli TIDAK PERNAH masuk repo. chmod 600.
# Password DB: huruf dan angka saja (masuk ke URL), mis. `openssl rand -hex 24`.

# --- Image ---------------------------------------------------------------
# SHA commit penuh dari main (ADR 0006). Repo di /srv/waregos/repo harus
# di-checkout ke SHA yang sama. Dipakai juga untuk image backup (dibangun dari commit yang sama).
API_IMAGE_TAG=<sha-commit-penuh>
# Tag sebelumnya, untuk rollback (tukar baris lalu `pull && up -d`):
# API_IMAGE_TAG=<sha-sebelumnya>

# Postgres 17 minor, minimal 17.11. Harus sama dengan isi deploy/postgres-tag
# (base image backup). Naik versi: ubah file itu lewat commit, lalu samakan baris ini.
POSTGRES_TAG=17.11-bookworm

# Versi cloudflared yang di-pin (lihat rilis github.com/cloudflare/cloudflared), jangan `latest`.
CLOUDFLARED_TAG=<versi-cloudflared>

# --- Database ------------------------------------------------------------
# Superuser `postgres`: hanya untuk bootstrap. Dibaca saat volume db pertama kali dibuat.
POSTGRES_SUPERUSER_PASSWORD=<password-superuser>
# Pemilik skema: migrasi dan restore. Harus sama dengan `\password waregos_owner`.
WAREGOS_OWNER_PASSWORD=<password-owner>
# Dipakai API (DML saja). Harus sama dengan `\password waregos_app`.
WAREGOS_APP_PASSWORD=<password-app>
# Read-only untuk backup (tiket 05). Harus sama dengan `\password waregos_backup`.
WAREGOS_BACKUP_PASSWORD=<password-backup>

# --- API -----------------------------------------------------------------
# Minimal 32 karakter acak, mis. `openssl rand -hex 32`.
JWT_SECRET=<rahasia-jwt>
# Origin web yang boleh memanggil API, dipisah koma.
# Sampai cutover stabil: https://app.waregos.com,https://waregos.pages.dev
CORS_ORIGINS=<https://origin-web>

# --- Tunnel --------------------------------------------------------------
# Token tunnel remotely-managed dari dashboard Cloudflare (tiket 09).
# Boleh kosong di laptop selama cloudflared tidak dinyalakan.
CLOUDFLARED_TUNNEL_TOKEN=<token-tunnel>

# --- Backup (tiket 05, ADR 0007) -----------------------------------------
# Boleh kosong sampai akun R2 dan healthchecks ada (tiket 09); job backup
# menolak jalan kalau ada yang kosong.
# Kunci PUBLIK age yang sama dengan db-backup.yml (diawali age1). Kunci privat tidak pernah di VPS.
AGE_RECIPIENT=<age1...>
# Endpoint S3 R2: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=<endpoint-r2>
R2_BUCKET=<nama-bucket>
# Token R2 khusus VPS: Object Read & Write, hanya bucket ini.
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
# URL ping check `waregos-backup` di healthchecks.io (https://hc-ping.com/<uuid>), tanpa garis miring di akhir.
HEALTHCHECK_URL=<url-ping>
