# Salin ke .env.rehearsal lalu isi. JANGAN commit .env.rehearsal.
# Password DB: huruf dan angka saja (karakter seperti @ atau / merusak URL koneksi).
REHEARSAL_DB_PASSWORD=ganti-dengan-huruf-angka-acak
SEED_ADMIN_USERNAME=admin
# Minimal 12 karakter (seed produksi menolak yang lebih pendek)
SEED_ADMIN_PASSWORD=ganti-dengan-kalimat-sandi-uji
# Hasil: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
REHEARSAL_JWT_SECRET=tempel-hasil-perintah-node